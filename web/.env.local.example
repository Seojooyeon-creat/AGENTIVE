# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://bxqlcyemmctykdngvocn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# 관심 키워드 API(user_keywords)는 RLS로 anon 접근이 막혀 있어 service_role 키 필요 (서버 전용, 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 웹 푸시(PWA) VAPID 공개키 — `npx web-push generate-vapid-keys` 로 생성. 비밀키는 크롤러(GitHub Secrets VAPID_PRIVATE_KEY)에만.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_run_openssl_rand_base64_32

# Google OAuth (Google Cloud Console에서 발급)
# 승인된 리디렉션 URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 관리자 페이지(/admin) 접근 허용 이메일, 쉼표 구분
ADMIN_EMAILS=admin@example.com
